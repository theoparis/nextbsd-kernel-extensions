# Ath12k.kext: FreeBSD's if_ath12k module (sys/modules/ath12k), category hwdriver.
KEXT_NAME=Ath12k
KEXT_ID=org.nextbsd.driver.Ath12k
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=ath12k
KEXT_KO=if_ath12k.ko
KEXT_CATEGORY=hwdriver
KEXT_MATCH=required
KEXT_PERSONALITIES=""
KEXT_FIRMWARE="ath12k=ath12k/WCN7850/*"
# Not Network-Root yet: the firmware boots to mission mode but QMI/QRTR is not
# implemented in LinuxKPI, so no wlan interface appears and a warm reboot with
# the kext loaded leaves the card off the bus. Opt in manually with kextload.
KEXT_REQUIRED=""
